{
  "name": "sage-presenter",
  "productName": "SAGE Presenter",
  "version": "0.1.7",
  "private": true,
  "description": "Offline, socket-controlled web and media presentation player",
  "main": "dist/main.js",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/copy-assets.cjs",
    "test": "pnpm run build && node --test tests/core.test.cjs",
    "start": "electron . --config config.json",
    "package": "pnpm run build && node scripts/package.cjs",
    "test:desktop": "pnpm run build && node tests/smoke.cjs",
    "test:daemon": "node tests/daemon.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "electron": "44.3.0",
    "typescript": "~5.9.3"
  },
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
